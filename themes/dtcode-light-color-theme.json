    "activityBar.activeBorder": "#F5EFE0",
    "activityBar.activeBackground": "#F5EFE026",
    "activityBar.activeFocusBorder": "#F5EFE0",
    "activityBar.border": "#35426E",
    "activityBarBadge.background": "#C83538",
