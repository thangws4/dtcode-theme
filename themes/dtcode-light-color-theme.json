    "inputOption.activeBorder": "#C83538",
    "inputValidation.errorBorder": "#B42E31",
    "dropdown.background": "#FBF7EE",
    "dropdown.border": "#35426E",
    "checkbox.border": "#35426E",

    "scrollbarSlider.background": "#35426E26",
    "scrollbarSlider.hoverBackground": "#35426E40",
    "scrollbarSlider.activeBackground": "#35426E66",
    "progressBar.background": "#C83538",

    "terminal.background": "#F5EFE0",
    "terminal.foreground": "#35426E",
    "terminalCursor.foreground": "#C83538",
    "terminal.ansiBlack": "#35426E",
    "terminal.ansiRed": "#B42E31",
    "terminal.ansiGreen": "#2F6B3A",
    "terminal.ansiYellow": "#9A4A0B",
    "terminal.ansiBlue": "#2B5BA8",
    "terminal.ansiMagenta": "#5A3F8C",
    "terminal.ansiCyan": "#1F6A75",
    "terminal.ansiWhite": "#6B6656",
    "terminal.ansiBrightBlack": "#6B6656",
    "terminal.ansiBrightRed": "#C83538",
    "terminal.ansiBrightGreen": "#3A7F47",
    "terminal.ansiBrightYellow": "#B0580F",
    "terminal.ansiBrightBlue": "#3A6CC0",
    "terminal.ansiBrightMagenta": "#6E52A6",
    "terminal.ansiBrightCyan": "#287E8B",
    "terminal.ansiBrightWhite": "#35426E",

    "gitDecoration.modifiedResourceForeground": "#2B5BA8",
    "gitDecoration.untrackedResourceForeground": "#2F6B3A",
    "gitDecoration.deletedResourceForeground": "#B42E31",
    "gitDecoration.ignoredResourceForeground": "#9A9483",
    "gitDecoration.conflictingResourceForeground": "#9A4A0B"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6B6656", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#B42E31", "fontStyle": "bold" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#35426E" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#2F6B3A" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#1F6A75" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#9A4A0B" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#2B5BA8" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#1F6A75" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#35426E" } },
    { "scope": ["variable.language", "variable.other.constant"], "settings": { "foreground": "#9A4A0B" } },
    { "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#5A3F8C" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#B42E31" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#9A4A0B" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#B42E31", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "markup.link"], "settings": { "foreground": "#2B5BA8" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#1F6A75" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#2F6B3A" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#B42E31" } },
    { "scope": ["invalid"], "settings": { "foreground": "#B42E31", "fontStyle": "underline" } }
  ]
}
