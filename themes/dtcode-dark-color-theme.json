    "scrollbarSlider.background": "#F5EFE01A",
    "scrollbarSlider.hoverBackground": "#F5EFE033",
    "scrollbarSlider.activeBackground": "#F5EFE04D",
    "progressBar.background": "#F0706A",

    "terminal.background": "#000000",
    "terminal.foreground": "#F5EFE0",
