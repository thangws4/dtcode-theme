    "terminal.ansiBrightBlack": "#8C8678",
    "terminal.ansiBrightRed": "#F59A95",
    "terminal.ansiBrightGreen": "#B8DDA9",
    "terminal.ansiBrightYellow": "#F5C08E",
    "terminal.ansiBrightBlue": "#B3CBF5",
