    "gitDecoration.modifiedResourceForeground": "#8FB2F0",
    "gitDecoration.untrackedResourceForeground": "#9CCB8A",
    "gitDecoration.deletedResourceForeground": "#F0706A",
    "gitDecoration.ignoredResourceForeground": "#5C584E",
    "gitDecoration.conflictingResourceForeground": "#F0A35E"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8C8678", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#F0706A", "fontStyle": "bold" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#F5EFE0" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#9CCB8A" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#6CC5C9" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#F0A35E" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#8FB2F0" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#6CC5C9" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#F5EFE0" } },
    { "scope": ["variable.language", "variable.other.constant"], "settings": { "foreground": "#F0A35E" } },
    { "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#C3A6F0" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#F0706A" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#F0A35E" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#F0706A", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "markup.link"], "settings": { "foreground": "#8FB2F0" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#6CC5C9" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#9CCB8A" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#F0706A" } },
    { "scope": ["invalid"], "settings": { "foreground": "#F0706A", "fontStyle": "underline" } }
  ]
}
